# Common defaults
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_LWIP_SO_REUSE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Custom partition table (4MB classic; S3 variants override via sdkconfig.defaults.<board>)
# app0/app1 = 1.75 MB each, spiffs = 384 KB (LittleFS), coredump = 64 KB
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/esp32dev.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Task watchdog disabled — we use platform::yield() for cooperative scheduling
CONFIG_ESP_TASK_WDT_EN=n

# lwIP core locking — socket calls take the TCP/IP core mutex and run inline
# instead of context-switching to the tcpip_thread per call. Large win for the
# ArtNet send path (97 UDP packets per frame).
CONFIG_LWIP_TCPIP_CORE_LOCKING=y

# Larger TCP send buffer so the preview WebSocket frame (up to ~5.5 KB at the
# finest detail level) fits in one non-blocking write with comfortable headroom
# — avoids partial sends that would drop and reconnect the preview connection.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# Ethernet hardware (RMII PHY pins, DMA buffer sizes) lives in
# sdkconfig.defaults.<board> for boards that have it. The base file is
# board-neutral so a WiFi-only ESP32 build doesn't reserve RMII GPIOs or
# allocate Ethernet DMA buffers it can't use.

# FreeRTOS task introspection for TasksModule (uxTaskGetSystemState): the trace facility is
# cheap — a bit of RAM/flash, no per-context-switch cost. The per-task CPU% counter
# (GENERATE_RUN_TIME_STATS) is NOT enabled here: it costs ~5% tick (measured) and is gated
# behind the MM_TASK_CPU_STATS build flag for profiling builds only.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Optimize for performance (-O2). IDF's default is COMPILER_OPTIMIZATION_DEBUG (-Og), which is the wrong
# trade for this firmware: the WS2812 shift encoder is SWAR bit-twiddling (delta-swaps, inlined templates)
# on a 32-bit Xtensa — code whose whole performance is register allocation across inlined calls, which -Og
# does not do — and it carries the tightest deadline in the system, since the streaming ring's EOF ISR must
# re-encode a slice before the DMA drains the next buffer. Measured on an S3: -O2 is 1.5x on that encode.
#
# The trade is the usual one: -O2 is harder to step through in a debugger and grows flash somewhat.
# Neither costs an end user anything, and a debug build remains one menuconfig away for the rare case
# that wants it. ASSERTIONS stay ENABLED (IDF's default): they are cheap next to the codegen win and
# they are what turns a silent corruption into a loud abort.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
