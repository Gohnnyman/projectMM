# ESP32-WROVER (classic ESP32, 4 MB flash + quad PSRAM)
# Append to sdkconfig.defaults + sdkconfig.defaults.eth (later fragment wins). The base
# already sets the 4 MB flash + esp32dev.csv partition the WROVER uses, so this fragment
# only adds PSRAM (and the exec heap) on top of the classic esp32 config.

# PSRAM — the WROVER carries a quad-mode PSRAM chip (unlike the S3/P4 octal path).
# CONFIG_SPIRAM=y on a classic-ESP32 target selects quad SPI PSRAM by default (there is no
# CONFIG_SPIRAM_MODE_OCT on classic ESP32 — that option only exists on the S3), so enabling
# SPIRAM is all the mode selection the WROVER needs.
#
# USABLE size is 4 MB even on an 8 MB WROVER chip: the classic ESP32's external-RAM address
# window is a fixed 4 MB (MMU hardware limit), so IDF maps only 4 MB into the heap — the boot
# log's "Found 8MB PSRAM device … 4MB is mapped" is that limit, not a misconfig. The System
# UI's psram total reports the mapped 4 MB (the heap-usable amount), not the detected chip
# size. The remaining PSRAM beyond 4 MB is only reachable via the manual himem banking API,
# which nothing here uses; on classic-ESP32 silicon 4 MB is the practical ceiling.
CONFIG_SPIRAM=y

# MoonLive native codegen needs an executable heap (allocExec → MALLOC_CAP_EXEC IRAM).
# MALLOC_CAP_EXEC is gated behind CONFIG_HEAP_HAS_EXEC_HEAP, which IDF disables whenever
# memory protection (W^X) is on. A JIT needs writable-then-executable memory, so disable
# memprot to enable the exec heap — the standard ESP32-JIT configuration, same as the S3
# PSRAM fragments; the safety story for scripted code is the staged bounds/watchdog checks.
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_HEAP_HAS_EXEC_HEAP=y
