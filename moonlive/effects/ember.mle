// Ember: a fire that simulates rather than draws. Each cell holds a heat value that decays and
// re-ignites at random, so this frame depends on the last one — `heat` is the state that makes
// it a simulation rather than a formula.

class EmberEffect {
  uint8_t  cool = 30;
  uint8_t  spark = 60;
  uint16_t phase = 0;
  uint16_t cycle = 1000;   // wraps past 255, which is why it is uint16_t
  uint8_t  heat[16];

  defineControls() {
    addUint8("cool", cool, 1, 120);
    addUint8("spark", spark, 0, 200);
    addUint16("cycle", cycle, 100, 2000);
  }

  tick() {
    phase = phase + 7;
    if (phase >= cycle) { phase = 0; }

    for (i = 0; i < 16; i = i + 1) {
      if (heat[i] > cool) { heat[i] = heat[i] - cool; } else { heat[i] = 0; }
    }

    for (j = 0; j < 16; j = j + 1) {
      if (random16(256) < spark) { heat[j] = 255; }
    }

    for (k = 0; k < 16; k = k + 1) {
      setRGB(k, paletteR(heat[k], heat[k]), paletteG(heat[k], heat[k]),
                paletteB(heat[k], heat[k]));
    }
  }
}
