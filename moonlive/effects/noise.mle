// Perlin-style value noise coloured by the palette: the field every fire, cloud and plasma effect
// starts from. Ported from MoonLight's E_noise.sc.
//
// `zoom` sets how much of the field the fixture spans, and the clock feeds a third noise axis so
// the field EVOLVES in place rather than sliding across the fixture — the original scrolls it,
// which reads as motion but shows the same shapes going past.
//
// The time axis must be MONOTONIC. Feeding it a beat() sawtooth ramps through one noise cell and
// then snaps back to the start of it, which reads as a hiccup once per beat. `t` only ever grows,
// so scaling it keeps walking into new cells and the field never jumps.

class NoiseEffect {
  uint8_t speed = 20;
  uint8_t zoom = 8;

  defineControls() {
    addUint8("speed", speed, 1, 120);
    addUint8("zoom", zoom, 1, 32);
  }

  tick() {
    for (y = 0; y < height; y = y + 1) {
      for (x = 0; x < width; x = x + 1) {
        setPaletteColor(x, y, noise(x * zoom, y * zoom, scale(t, speed * 280)), 255);
      }
    }
  }
}
