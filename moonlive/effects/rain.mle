// Rain: drops falling from anywhere along the top, with wind.
// Wind is the launch angle, not a force, so gravity curves each drop as it falls.

class RainEffect {
  byte fall = 24;
  byte wind = 128;
  byte drops = 3;

  int dimensions() { return 2; }   // an x/y picture; extrude copies it through the depth

  string tags() { return "✨"; }   // particles

  void defineControls() {
    pool(400);
    addControl("fall", fall, 4, 80);
    addControl("wind", wind, 0, 255);
    addControl("drops", drops, 1, 12);
  }

  void tick() {
    fade(90);

    // 16384 is straight down. Wind leans the launch either side of it.
    emit(random16(width), 0, 16384 + wind * 24 - 3072, fall * height / 8,
         drops, 120, scale(beat(3, t), 256));

    gravity(fall * height / 24);
    step();
    age(1);
    render(120);
  }
}
