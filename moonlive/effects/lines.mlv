// A red column and a green row sweeping the grid.
// `width`/`height` come from the LAYER. The fill clears last frame.
uint8_t bpm = 30;   // @control 1..240

fill(0, 0, 0);

for (y = 0; y < height; y = y + 1) {
  setRGB(y * width + scale(beat(bpm, t), width), 255, 0, 0);
}
for (x = 0; x < width; x = x + 1) {
  setRGB(scale(beat(bpm, t), height) * width + x, 0, 255, 0);
}
