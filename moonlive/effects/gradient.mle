// Gradient: red rising across the rig while blue falls, the simplest thing that is still a picture.

class GradientEffect {
  int n = 0;                      // total lights, whatever the shape

  int dimensions() { return 3; }

  string tags() { return "💫"; }

  void tick() {
    n = width * height * depth;
    for (int i = 0; i < n; i = i + 1) {
      setRGB(i, div(i * 255, n), 255 - div(i * 255, n), 60);
    }
  }
}
