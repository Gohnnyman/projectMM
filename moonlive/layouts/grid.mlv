// A grid, the layout almost every panel is. The nested loop and the index arithmetic
// are the whole definition — this is the shipped default.
uint8_t width = 16;  // @control 1..64
uint8_t height = 16; // @control 1..64

for (yy = 0; yy < height; yy = yy + 1) {
  for (xx = 0; xx < width; xx = xx + 1) {
    addLight(xx, yy, 0);
  }
}
