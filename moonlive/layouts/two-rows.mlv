// Two rows from one strand: the wire runs out along y=0 and back along y=1.
// The return row counts x DOWN, because the strand physically turns around at the far end — the
// last light of row 0 and the first of row 1 are neighbours on the wire.
uint8_t width = 16; // @control 1..64

for (i = 0; i < width; i = i + 1) {
  addLight(i, 0, 0);
}
for (i = 0; i < width; i = i + 1) {
  addLight(width - 1 - i, 1, 0);
}
