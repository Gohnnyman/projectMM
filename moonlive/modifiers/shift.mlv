// Slide along x. A coordinate is a byte, so keep amount small enough that xPos + amount stays under
// 256: past that it wraps and the light reappears at the left edge.

class ShiftModifier {
  uint8_t amount = 4;

  defineControls() {
    addUint8("amount", amount, 0, 64);
  }

  modifyLogical() {
    setXYZ(0, xPos + amount, yPos, zPos);
  }
}
